<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: black background with the animated-in logo, then straight into Compose. -->
    <style name="Theme.Ordo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Ordo</item>
    </style>

    <style name="Theme.Ordo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
